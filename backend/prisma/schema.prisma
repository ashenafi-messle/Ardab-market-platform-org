// ==============================================================================
// Ardab Market - Prisma Schema
// ==============================================================================
// Source of truth for database models.
// Compatible with PostgreSQL hosted on Neon.
// Supports both connection pooling (DATABASE_URL) and direct migration (DIRECT_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  SUB_ADMIN
  OPERATIONS_MANAGER
  DISPATCHER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OtpPurpose {
  LOGIN_VERIFICATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
  SECURITY_VERIFICATION
}

enum SupplierStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SupplierVerificationStatus {
  VERIFIED
  PENDING
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CustomerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  ASSIGNED_TO_TRIP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
  RETURNED
  REJECTED
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  READY_FOR_ASSIGNMENT
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum TripStatus {
  PLANNING
  LOADING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  NOTIFICATION
  OPERATIONAL_ALERT
  SYSTEM_ANNOUNCEMENT
}

enum NotificationCategory {
  ORDER
  DELIVERY
  FLEET
  SECURITY
  SYSTEM
  PAYMENT
  CUSTOMER
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportSenderType {
  CUSTOMER
  SUBADMIN
  SYSTEM
}

enum SupportMessageType {
  MESSAGE
  INTERNAL_NOTE
  SYSTEM_EVENT
}

enum SupportEmailStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
}

enum ComponentCategory {
  CORE_API
  DATABASE
  GIS_ENGINE
  CACHE
  TELEMETRY
  PAYMENTS
}

enum ServiceHealthStatus {
  HEALTHY
  DEGRADED
  MAINTENANCE
  OFFLINE
}

enum MaintenanceType {
  SCHEDULED
  EMERGENCY
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceStatus {
  PLANNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum MaintenanceScope {
  PLATFORM
  SERVICE
  CITY
  INFRASTRUCTURE
  DATABASE
  API
}

enum MaintenanceTaskCategory {
  DATABASE
  CACHE
  STORAGE
  SECURITY
}

enum TaskExecutionStatus {
  SUCCESS
  RUNNING
  FAILED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
  CLOSED
}

enum EquipmentServiceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE
}

enum AttributeStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum LogisticsFieldMode {
  NOT_USED
  OPTIONAL
  REQUIRED
}

// ------------------------------------------------------------------------------
// Admin Authentication & Identity
// ------------------------------------------------------------------------------

model AdminUser {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           UserRole   @default(SUPER_ADMIN)
  status         UserStatus @default(ACTIVE)
  avatar         String?
  phone          String?
  assignedCities String[]   @default(["All Cities"])
  lastLogin      DateTime?
  failedLoginAttempts Int   @default(0)
  lockedUntil         DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions                  AdminSession[]
  passwordResetTokens       PasswordResetToken[]
  otps                      AdminOtp[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  notificationRecipients    NotificationRecipient[]
  assignedSupportTickets    SupportTicket[]                  @relation("AssignedSubadmin")
  supportStatusChanges      SupportTicketStatusHistory[]     @relation("StatusChangedBy")
  supportAssignmentsFrom    SupportTicketAssignmentHistory[] @relation("AssignedFromSubadmin")
  supportAssignmentsTo      SupportTicketAssignmentHistory[] @relation("AssignedToSubadmin")
  supportAssignmentsChanged SupportTicketAssignmentHistory[] @relation("AssignmentChangedBy")
  feedbackResponses         FeedbackResponse[]
  reviewedFeedbackReports   FeedbackReport[]
  moderatedFeedbacks        FeedbackModerationHistory[]
  feedbackStatusChanges     FeedbackStatusHistory[]
  securityAlertsAssigned    SecurityAlert[]                  @relation("AlertAssignedTo")
  securityAlertsResolved    SecurityAlert[]                  @relation("AlertResolvedBy")
  ipRulesCreated            IpBlockRule[]                    @relation("IpRuleCreatedBy")
  securityAlertChanges      SecurityAlertHistory[]           @relation("AlertChangedBy")
  maintenanceRecordsCreated MaintenanceRecord[]              @relation("MaintenanceCreatedBy")
  maintenanceRecordsCompleted MaintenanceRecord[]            @relation("MaintenanceCompletedBy")
  maintenanceStatusChanges   MaintenanceStatusHistory[]       @relation("MaintenanceStatusChangedBy")
  maintenanceTasksTriggered MaintenanceTask[]                @relation("TaskTriggeredBy")
  incidentsCreated           SystemIncident[]                 @relation("IncidentCreatedBy")
  incidentsAssigned          SystemIncident[]                 @relation("IncidentAssignedTo")
  incidentsResolved          SystemIncident[]                 @relation("IncidentResolvedBy")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("admin_users")
}

// ------------------------------------------------------------------------------
// Admin Active Sessions & Revocation
// ------------------------------------------------------------------------------

model AdminSession {
  id        String        @id @default(uuid())
  adminId   String
  tokenHash String        @unique
  ipAddress String?
  userAgent String?
  status    SessionStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// ------------------------------------------------------------------------------
// Password Reset Tokens
// ------------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ------------------------------------------------------------------------------
// One-Time Passwords (OTP) & Verification
// ------------------------------------------------------------------------------

model AdminOtp {
  id        String     @id @default(uuid())
  adminId   String
  codeHash  String
  purpose   OtpPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@index([purpose])
  @@map("admin_otps")
}

// ------------------------------------------------------------------------------
// Security & Governance Audit Logging
// ------------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  adminId        String?
  adminEmail     String
  action         String
  entity         String
  entityId       String?
  ipAddress      String?
  changesSummary String?
  status         String   @default("SUCCESS")
  timestamp      DateTime @default(now())

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminEmail])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// Payment Method Configurations (Platform Settlement Channels)
// ------------------------------------------------------------------------------

model PaymentMethod {
  id            String    @id @default(uuid())
  name          String
  provider      String?
  accountName   String?
  accountNumber String?
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  suppliers     Supplier[]

  @@index([name])
  @@index([isActive])
  @@map("payment_methods")
}

// ------------------------------------------------------------------------------
// Supplier Management & Agricultural Producers
// ------------------------------------------------------------------------------

model Supplier {
  id                 String                     @id @default(uuid())
  companyName        String
  name               String
  phone              String
  email              String?
  city               String
  category           String?
  tinNumber          String?
  address            String
  status             SupplierStatus             @default(ACTIVE)
  verificationStatus SupplierVerificationStatus @default(PENDING)
  notes              String?
  paymentMethodId    String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  paymentMethod      PaymentMethod?             @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  paymentMethods     SupplierPaymentMethod[]
  sellerCategories   SellerMarketplaceCategory[]
  products           Product[]
  feedbacks          Feedback[]

  @@index([companyName])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([city])
  @@index([status])
  @@index([verificationStatus])
  @@index([paymentMethodId])
  @@index([createdAt])
  @@map("suppliers")
}

// ------------------------------------------------------------------------------
// Supplier Payment Methods (Multi-Channel Settlement Accounts)
// ------------------------------------------------------------------------------

model SupplierPaymentMethod {
  id            String   @id @default(uuid())
  supplierId    String
  paymentMethod String
  accountNumber String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([paymentMethod])
  @@map("supplier_payment_methods")
}

// ------------------------------------------------------------------------------
// Marketplace Categories
// ------------------------------------------------------------------------------

model MarketplaceCategory {
  id               String                      @id @default(uuid())
  parentId         String?
  name             String
  slug             String                      @unique
  icon             String?
  description      String?
  imageUrl         String?
  isActive         Boolean                     @default(true)
  sortOrder        Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  parent           MarketplaceCategory?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         MarketplaceCategory[]       @relation("CategoryHierarchy")

  sellerCategories SellerMarketplaceCategory[]
  products         Product[]
  categoryAttributes CategoryAttribute[]
  logisticsConfig  CategoryLogisticsConfig?

  @@index([parentId])
  @@index([name])
  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@index([parentId, isActive, sortOrder])
  @@map("marketplace_categories")
}

// ------------------------------------------------------------------------------
// Category Logistics Configuration (Weight & Unit of Measure Rules)
// ------------------------------------------------------------------------------

model CategoryLogisticsConfig {
  id                String             @id @default(uuid())
  categoryId        String             @unique
  weightMode        LogisticsFieldMode @default(NOT_USED)
  unitOfMeasureMode LogisticsFieldMode @default(NOT_USED)
  defaultUnit       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  category          MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_logistics_configs")
}

// ------------------------------------------------------------------------------
// Attribute Definitions (Reusable Across Categories)
// ------------------------------------------------------------------------------

model AttributeDefinition {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  type                   AttributeType
  description            String?
  status                 AttributeStatus         @default(ACTIVE)
  isSystem               Boolean                 @default(false)
  unit                   String?
  validationRules        Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  options                AttributeOption[]
  categoryAttributes     CategoryAttribute[]
  productAttributeValues ProductAttributeValue[]

  @@index([slug])
  @@index([status])
  @@index([type])
  @@map("attribute_definitions")
}

// ------------------------------------------------------------------------------
// Attribute Options (Predefined Options for SELECT & MULTI_SELECT)
// ------------------------------------------------------------------------------

model AttributeOption {
  id                    String                  @id @default(uuid())
  attributeDefinitionId String
  label                 String
  value                 String
  sortOrder             Int                     @default(0)
  status                AttributeStatus         @default(ACTIVE)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  attributeDefinition   AttributeDefinition     @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)
  productAttributeValues ProductAttributeValue[]

  @@unique([attributeDefinitionId, value])
  @@index([attributeDefinitionId])
  @@index([attributeDefinitionId, status, sortOrder])
  @@map("attribute_options")
}

// ------------------------------------------------------------------------------
// Category Attributes (Mapping Category to Reusable Attribute Definition)
// ------------------------------------------------------------------------------

model CategoryAttribute {
  id                    String              @id @default(uuid())
  categoryId            String
  attributeDefinitionId String
  isRequired            Boolean             @default(false)
  isVisible             Boolean             @default(true)
  sortOrder             Int                 @default(0)
  configuration         Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  category              MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeDefinitionId])
  @@index([categoryId])
  @@index([categoryId, isVisible, sortOrder])
  @@index([attributeDefinitionId])
  @@map("category_attributes")
}

// ------------------------------------------------------------------------------
// Product Attribute Values (Normalized Category-Driven Attributes)
// ------------------------------------------------------------------------------

model ProductAttributeValue {
  id                    String              @id @default(uuid())
  productId             String
  attributeDefinitionId String
  optionId              String?
  valueText             String?
  valueNumber           Decimal?            @db.Decimal(14, 4)
  valueBoolean          Boolean?
  valueDate             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  product               Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  option                AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([productId, attributeDefinitionId, optionId])
  @@index([productId])
  @@index([attributeDefinitionId])
  @@index([optionId])
  @@map("product_attribute_values")
}

// ------------------------------------------------------------------------------
// Seller / Supplier Category Assignments (Many-to-Many)
// ------------------------------------------------------------------------------

model SellerMarketplaceCategory {
  id         String              @id @default(uuid())
  sellerId   String
  categoryId String
  createdAt  DateTime            @default(now())

  seller     Supplier            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category   MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([sellerId, categoryId])
  @@index([sellerId])
  @@index([categoryId])
  @@map("seller_marketplace_categories")
}

// ------------------------------------------------------------------------------
// Marketplace Products
// ------------------------------------------------------------------------------

model Product {
  id                    String                  @id @default(uuid())
  itemCode              String                  @unique
  name                  String
  description           String?
  sellerId              String
  marketplaceCategoryId String
  unit                  String?
  weight                Decimal?                @db.Decimal(10, 2)
  costPrice             Decimal?                @db.Decimal(12, 2)
  sellingPrice          Decimal                 @db.Decimal(12, 2)
  status                ProductStatus           @default(ACTIVE)
  cityAvailability      String[]                @default(["All Cities"])
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  seller                Supplier                @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category              MarketplaceCategory     @relation(fields: [marketplaceCategoryId], references: [id], onDelete: Restrict)
  images                ProductImage[]
  orderItems            OrderItem[]
  feedbacks             Feedback[]
  attributeValues       ProductAttributeValue[]
  wishlistItems         CustomerWishlistItem[]

  @@index([itemCode])
  @@index([sellerId])
  @@index([marketplaceCategoryId])
  @@index([status])
  @@index([createdAt])
  @@index([status, marketplaceCategoryId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, sellingPrice])
  @@map("products")
}

// ------------------------------------------------------------------------------
// Product Images (Cloudinary CDN Storage & Media Metadata)
// ------------------------------------------------------------------------------

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  publicId  String
  width     Int?
  height    Int?
  format    String?
  bytes     Int?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
  @@map("product_images")
}

// ------------------------------------------------------------------------------
// Customer Profiles & Commercial Consumer Identity
// ------------------------------------------------------------------------------

model Customer {
  id                 String                     @id @default(uuid())
  customerCode       String                     @unique
  fullName           String
  phone              String
  email              String?
  passwordHash       String?
  profileImageUrl    String?
  city               String                     @default("Gondar")
  deliveryZone       String?
  status             CustomerStatus             @default(ACTIVE)
  verificationStatus CustomerVerificationStatus @default(PENDING)
  lastActivityAt     DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  addresses          CustomerAddress[]
  orders             Order[]
  deliveries         Delivery[]
  scoreEvents        CustomerScoreEvent[]
  activities         CustomerActivity[]
  reviews            CustomerReview[]
  wishlistItems      CustomerWishlistItem[]
  supportTickets     SupportTicket[]
  feedbacks          Feedback[]

  @@index([customerCode])
  @@index([phone])
  @@index([email])
  @@index([city])
  @@index([status])
  @@index([verificationStatus])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@map("customers")
}

// ------------------------------------------------------------------------------
// Temporary Pending Registrations (Unverified Signups)
// ------------------------------------------------------------------------------

model PendingCustomerRegistration {
  id                    String    @id @default(uuid())
  email                 String
  phone                 String
  city                  String    @default("Gondar")
  deliveryZone          String?
  verificationTokenHash String    @unique
  verificationExpiresAt DateTime
  verifiedAt            DateTime?
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([email])
  @@index([phone])
  @@index([verificationTokenHash])
  @@index([verificationExpiresAt])
  @@map("pending_customer_registrations")
}

// ------------------------------------------------------------------------------
// Customer Delivery Addresses (Multi-Destination Support)
// ------------------------------------------------------------------------------

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String
  label        String   @default("Home")
  recipientName String
  phone        String
  city         String
  deliveryZone String?
  neighborhood String?
  addressLine  String
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([city])
  @@index([isDefault])
  @@map("customer_addresses")
}

// ------------------------------------------------------------------------------
// Commercial Marketplace Orders (Authoritative Order & Financial Truth)
// ------------------------------------------------------------------------------

model Order {
  id                      String                @id @default(uuid())
  orderNumber             String                @unique
  customerId              String
  city                    String
  deliveryZone            String?
  deliveryAddress         String?
  status                  OrderStatus           @default(PENDING)
  subtotal                Decimal               @db.Decimal(12, 2)
  deliveryFee             Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount          Decimal               @default(0) @db.Decimal(12, 2)
  taxAmount               Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount             Decimal               @db.Decimal(12, 2)
  totalWeight             Decimal               @default(0) @db.Decimal(10, 2)
  currency                String                @default("ETB")
  paymentMethod           String?
  paymentStatus           PaymentStatus         @default(PENDING)
  customerNote            String?
  internalNote            String?
  idempotencyKey          String?               @unique
  placedAt                DateTime              @default(now())
  confirmedAt             DateTime?
  processingAt            DateTime?
  readyAt                 DateTime?
  dispatchedAt            DateTime?
  deliveredAt             DateTime?
  cancelledAt             DateTime?
  cancelledReason         String?
  rejectedAt              DateTime?
  rejectedReason          String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  customer                Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                   OrderItem[]
  deliveryAddressSnapshot OrderDeliveryAddress?
  activities              OrderActivity[]
  delivery                Delivery?
  supportTickets          SupportTicket[]
  feedbacks               Feedback[]

  @@index([customerId])
  @@index([customerId, status])
  @@index([customerId, createdAt])
  @@index([customerId, placedAt(sort: Desc)])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([city])
  @@index([placedAt])
  @@index([createdAt])
  @@map("orders")
}

// ------------------------------------------------------------------------------
// Historical Order Items & Product Snapshots (Immutable Audit Truth)
// ------------------------------------------------------------------------------

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  productId           String?
  productNameSnapshot String
  itemCodeSnapshot    String
  unitSnapshot        String
  unitPrice           Decimal  @db.Decimal(12, 2)
  quantity            Int
  weightPerUnit       Decimal  @db.Decimal(10, 2)
  totalWeight         Decimal  @db.Decimal(10, 2)
  subtotal            Decimal  @db.Decimal(12, 2)
  sellerIdSnapshot    String?
  sellerNameSnapshot  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ------------------------------------------------------------------------------
// Order Delivery Address Snapshot (Preserved at Checkout)
// ------------------------------------------------------------------------------

model OrderDeliveryAddress {
  id           String   @id @default(uuid())
  orderId      String   @unique
  recipientName String
  phone        String
  city         String
  deliveryZone String?
  neighborhood String?
  addressLine  String
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  createdAt    DateTime @default(now())

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_delivery_addresses")
}

// ------------------------------------------------------------------------------
// Order Activity Log & Operational Lifecycle Trail
// ------------------------------------------------------------------------------

model OrderActivity {
  id          String       @id @default(uuid())
  orderId     String
  action      String
  fromStatus  OrderStatus?
  toStatus    OrderStatus?
  description String
  actor       String       @default("Super Admin")
  actorId     String?
  metadata    String?
  createdAt   DateTime     @default(now())

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, createdAt])
  @@map("order_activities")
}

// ------------------------------------------------------------------------------
// Customer Platform Score & Loyalty Events (System-Generated Experience Truth)
// ------------------------------------------------------------------------------

model CustomerScoreEvent {
  id          String   @id @default(uuid())
  customerId  String
  type        String
  points      Int
  source      String
  referenceId String?
  metadata    String?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, createdAt])
  @@index([type])
  @@map("customer_score_events")
}

// ------------------------------------------------------------------------------
// Customer Activity Log & Audit Trail (Chronological Event History)
// ------------------------------------------------------------------------------

model CustomerActivity {
  id          String   @id @default(uuid())
  customerId  String
  action      String
  description String
  actor       String   @default("Customer")
  metadata    String?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, createdAt])
  @@index([action])
  @@map("customer_activities")
}

// ------------------------------------------------------------------------------
// Customer Reviews & Feedback (Ratings Distinct from Score)
// ------------------------------------------------------------------------------

model CustomerReview {
  id         String   @id @default(uuid())
  customerId String
  orderId    String?
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([orderId])
  @@map("customer_reviews")
}

// ------------------------------------------------------------------------------
// Customer Wishlist Items (Persistent Server-Side Saved Products)
// ------------------------------------------------------------------------------

model CustomerWishlistItem {
  id         String    @id @default(uuid())
  customerId String
  productId  String?
  addedAt    DateTime  @default(now())
  createdAt  DateTime  @default(now())

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@index([addedAt])
  @@map("customer_wishlist_items")
}

// ------------------------------------------------------------------------------
// Fleet Logistics: Vehicles & Ardab Heavy Cargo Trucks (5,000 KG Capacity)
// ------------------------------------------------------------------------------

model Vehicle {
  id           String     @id @default(uuid())
  plateNumber  String     @unique
  model        String
  city         String
  capacityKg   Decimal    @default(5000.00) @db.Decimal(10, 2)
  status       String     @default("AVAILABLE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  trips        Trip[]
  deliveries   Delivery[]
  equipmentLogs FleetEquipmentLog[]

  @@index([plateNumber])
  @@index([city])
  @@index([status])
  @@map("vehicles")
}

// ------------------------------------------------------------------------------
// Fleet Logistics: Drivers & Transport Personnel
// ------------------------------------------------------------------------------

model Driver {
  id            String     @id @default(uuid())
  driverCode    String     @unique
  fullName      String
  phone         String
  email         String?
  city          String
  licenseNumber String?
  status        String     @default("AVAILABLE")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  trips         Trip[]
  deliveries    Delivery[]

  @@index([driverCode])
  @@index([phone])
  @@index([city])
  @@index([status])
  @@map("drivers")
}

// ------------------------------------------------------------------------------
// Fleet Logistics: Vehicle Trips & Multi-Order Consolidated Journeys
// ------------------------------------------------------------------------------

model Trip {
  id            String       @id @default(uuid())
  tripNumber    String       @unique
  city          String
  vehicleId     String?
  driverId      String?
  status        TripStatus   @default(PLANNING)
  maxCapacityKg Decimal      @default(5000.00) @db.Decimal(10, 2)
  totalWeightKg Decimal      @default(0.00) @db.Decimal(10, 2)
  pickupHub     String?
  deliveryZones String[]     @default([])
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver        Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  deliveries    Delivery[]

  @@index([tripNumber])
  @@index([city])
  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
  @@index([createdAt])
  @@map("trips")
}

// ------------------------------------------------------------------------------
// Delivery Operations & Order Fulfillment Truth
// ------------------------------------------------------------------------------

model Delivery {
  id                   String            @id @default(uuid())
  deliveryNumber       String            @unique
  orderId              String            @unique
  customerId           String
  tripId               String?
  driverId             String?
  vehicleId            String?
  status               DeliveryStatus    @default(PENDING)
  city                 String
  deliveryZone         String?
  neighborhood         String?
  addressLine          String
  recipientName        String
  recipientPhone       String
  latitude             Decimal?          @db.Decimal(10, 8)
  longitude            Decimal?          @db.Decimal(11, 8)
  scheduledAt          DateTime?
  estimatedDeliveryAt  DateTime?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  deliveryFee          Decimal           @default(0) @db.Decimal(12, 2)
  deliveryNotes        String?
  failureReason        String?
  cancellationReason   String?
  proofOfDeliveryUrl   String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  order                Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer             Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  trip                 Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  driver               Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle              Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  activities           DeliveryActivity[]
  feedbacks            Feedback[]

  @@index([deliveryNumber])
  @@index([orderId])
  @@index([customerId])
  @@index([tripId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([city])
  @@index([deliveryZone])
  @@index([scheduledAt])
  @@index([deliveredAt])
  @@index([createdAt])
  @@map("deliveries")
}

// ------------------------------------------------------------------------------
// Delivery Activity Log & Operational Audit Trail
// ------------------------------------------------------------------------------

model DeliveryActivity {
  id          String          @id @default(uuid())
  deliveryId  String
  action      String
  fromStatus  DeliveryStatus?
  toStatus    DeliveryStatus?
  description String
  actor       String          @default("Super Admin")
  actorId     String?
  metadata    String?
  createdAt   DateTime        @default(now())

  delivery    Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([deliveryId, createdAt])
  @@map("delivery_activities")
}

// ------------------------------------------------------------------------------
// Notifications & Operational Alerts Module
// ------------------------------------------------------------------------------

model Notification {
  id         String               @id @default(uuid())
  type       NotificationType     @default(NOTIFICATION)
  category   NotificationCategory @default(SYSTEM)
  title      String
  message    String
  severity   NotificationSeverity @default(INFO)
  priority   NotificationPriority @default(NORMAL)
  isAlert    Boolean              @default(false)
  entityType String?
  entityId   String?
  actionUrl  String?
  metadata   String?
  targetRole UserRole?
  adminId    String?
  createdAt  DateTime             @default(now())
  expiresAt  DateTime?

  admin      AdminUser?           @relation(fields: [adminId], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([type])
  @@index([category])
  @@index([severity])
  @@index([priority])
  @@index([isAlert])
  @@index([entityType, entityId])
  @@index([targetRole])
  @@index([adminId])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRecipient {
  id                   String       @id @default(uuid())
  notificationId       String
  adminId              String
  isRead               Boolean      @default(false)
  readAt               DateTime?
  isAcknowledged       Boolean      @default(false)
  acknowledgedAt       DateTime?
  acknowledgedById     String?
  acknowledgementNotes String?
  createdAt            DateTime     @default(now())

  notification         Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin                AdminUser    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([notificationId, adminId])
  @@index([notificationId])
  @@index([adminId])
  @@index([isRead])
  @@index([isAcknowledged])
  @@index([createdAt])
  @@map("notification_recipients")
}

// ------------------------------------------------------------------------------
// Customer Support Categories
// ------------------------------------------------------------------------------

model SupportCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets     SupportTicket[]

  @@map("support_categories")
}

// ------------------------------------------------------------------------------
// Customer Support Tickets
// ------------------------------------------------------------------------------

model SupportTicket {
  id                    String                @id @default(uuid())
  ticketNumber          String                @unique
  customerId            String
  assignedSubadminId    String?
  categoryId            String?
  orderId               String?
  city                  String                @default("Gondar")
  status                SupportTicketStatus   @default(OPEN)
  priority              SupportTicketPriority @default(NORMAL)
  subject               String
  description           String?
  resolutionNotes       String?
  lastMessageAt         DateTime              @default(now())
  lastCustomerMessageAt DateTime?
  lastAgentMessageAt    DateTime?
  firstResponseAt       DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedSubadmin      AdminUser?            @relation("AssignedSubadmin", fields: [assignedSubadminId], references: [id], onDelete: SetNull)
  category              SupportCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order                 Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  messages              SupportMessage[]
  statusHistory         SupportTicketStatusHistory[]
  assignmentHistory     SupportTicketAssignmentHistory[]
  emailLogs             SupportEmailLog[]

  @@index([ticketNumber])
  @@index([customerId])
  @@index([customerId, status])
  @@index([customerId, lastMessageAt(sort: Desc)])
  @@index([assignedSubadminId])
  @@index([assignedSubadminId, status])
  @@index([categoryId])
  @@index([status])
  @@index([priority])
  @@index([city])
  @@index([lastMessageAt])
  @@index([createdAt])
  @@map("support_tickets")
}

// ------------------------------------------------------------------------------
// Support Conversation & Messages (Customer Replies & Staff Internal Notes)
// ------------------------------------------------------------------------------

model SupportMessage {
  id             String              @id @default(uuid())
  ticketId       String
  senderUserId   String
  senderType     SupportSenderType
  messageType    SupportMessageType  @default(MESSAGE)
  body           String
  isInternal     Boolean             @default(false)
  emailStatus    SupportEmailStatus?
  emailMessageId String?
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  ticket         SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  emailLogs      SupportEmailLog[]

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@index([senderUserId])
  @@index([emailStatus])
  @@index([createdAt])
  @@map("support_messages")
}

// ------------------------------------------------------------------------------
// Support Ticket Status Transition Audit Trail
// ------------------------------------------------------------------------------

model SupportTicketStatusHistory {
  id          String               @id @default(uuid())
  ticketId    String
  changedById String
  oldStatus   SupportTicketStatus?
  newStatus   SupportTicketStatus
  reason      String?
  createdAt   DateTime             @default(now())

  ticket      SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy   AdminUser            @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([changedById])
  @@index([createdAt])
  @@map("support_ticket_status_history")
}

// ------------------------------------------------------------------------------
// Support Ticket Staff Assignment Audit Trail
// ------------------------------------------------------------------------------

model SupportTicketAssignmentHistory {
  id             String        @id @default(uuid())
  ticketId       String
  assignedFromId String?
  assignedToId   String?
  changedById    String
  createdAt      DateTime      @default(now())

  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedFrom   AdminUser?    @relation("AssignedFromSubadmin", fields: [assignedFromId], references: [id], onDelete: SetNull)
  assignedTo     AdminUser?    @relation("AssignedToSubadmin", fields: [assignedToId], references: [id], onDelete: SetNull)
  changedBy      AdminUser     @relation("AssignmentChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([assignedFromId])
  @@index([assignedToId])
  @@index([changedById])
  @@index([createdAt])
  @@map("support_ticket_assignment_history")
}

// ------------------------------------------------------------------------------
// Customer Support Transactional Email Delivery Logs
// ------------------------------------------------------------------------------

model SupportEmailLog {
  id                String              @id @default(uuid())
  ticketId          String?
  messageId         String?
  recipientEmail    String
  recipientName     String?
  subject           String
  provider          String              @default("brevo")
  providerMessageId String?
  status            SupportEmailStatus  @default(QUEUED)
  attemptCount      Int                 @default(0)
  lastError         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  ticket            SupportTicket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  message           SupportMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([messageId])
  @@index([recipientEmail])
  @@index([status])
  @@index([createdAt])
  @@map("support_email_logs")
}

// ------------------------------------------------------------------------------
// Feedback & Reputation Management Enums
// ------------------------------------------------------------------------------

enum FeedbackType {
  PRODUCT
  DELIVERY
  PLATFORM
  SUPPLIER
  ORDER
  CUSTOMER_SERVICE
}

enum FeedbackStatus {
  NEW
  PENDING
  PUBLISHED
  UNDER_REVIEW
  REVIEWED
  RESOLVED
  FLAGGED
  HIDDEN
  REJECTED
  ARCHIVED
}

enum FeedbackVisibility {
  PUBLIC
  PRIVATE
  HIDDEN
}

enum FeedbackSource {
  ORDER
  PRODUCT
  SELLER
  DELIVERY
  SUPPORT
  PLATFORM
}

enum FeedbackSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackResponderType {
  SUBADMIN
  ADMIN
  SELLER
  SYSTEM
}

enum FeedbackReportReason {
  SPAM
  ABUSIVE_LANGUAGE
  HARASSMENT
  FALSE_INFORMATION
  INAPPROPRIATE_CONTENT
  DUPLICATE
  OTHER
}

enum FeedbackReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum FeedbackModerationAction {
  PUBLISH
  HIDE
  REJECT
  RESOLVE
  ARCHIVE
  RESTORE
}

// ------------------------------------------------------------------------------
// Customer Feedback & Reputation Categories
// ------------------------------------------------------------------------------

model FeedbackCategory {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  type        FeedbackType  @default(PLATFORM)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  feedbacks   Feedback[]

  @@index([type])
  @@index([isActive])
  @@map("feedback_categories")
}

// ------------------------------------------------------------------------------
// Customer Feedback, Ratings & Operational Reviews
// ------------------------------------------------------------------------------

model Feedback {
  id               String               @id @default(uuid())
  customerId       String?
  authorName       String
  authorRole       String               @default("CUSTOMER")
  orderId          String?
  productId        String?
  sellerId         String?
  deliveryId       String?
  categoryId       String?
  type             FeedbackType         @default(PLATFORM)
  source           FeedbackSource       @default(PLATFORM)
  city             String               @default("Gondar")
  rating           Int                  // 1 to 5
  title            String
  comment          String
  targetEntityName String?
  sentiment        FeedbackSentiment    @default(NEUTRAL)
  status           FeedbackStatus       @default(PUBLISHED)
  visibility       FeedbackVisibility   @default(PUBLIC)
  isVerified       Boolean              @default(false)
  isAnonymous      Boolean              @default(false)
  publishedAt      DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  customer         Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order            Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product          Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  seller           Supplier?            @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  delivery         Delivery?            @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  category         FeedbackCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  responses        FeedbackResponse[]
  reports          FeedbackReport[]
  moderationHistory FeedbackModerationHistory[]
  statusHistory    FeedbackStatusHistory[]

  @@index([customerId])
  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
  @@index([deliveryId])
  @@index([categoryId])
  @@index([type])
  @@index([source])
  @@index([city])
  @@index([status])
  @@index([visibility])
  @@index([rating])
  @@index([isVerified])
  @@index([createdAt])
  @@index([productId, status, visibility, createdAt(sort: Desc)])
  @@index([customerId, type, status, createdAt(sort: Desc)])
  @@map("feedbacks")
}

// ------------------------------------------------------------------------------
// Official Feedback Responses (Administrative & Merchant Engagement)
// ------------------------------------------------------------------------------

model FeedbackResponse {
  id            String                @id @default(uuid())
  feedbackId    String
  responderId   String?
  responderType FeedbackResponderType @default(SUBADMIN)
  responderName String?
  body          String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  feedback      Feedback              @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  responder     AdminUser?            @relation(fields: [responderId], references: [id], onDelete: SetNull)

  @@index([feedbackId])
  @@index([responderId])
  @@index([createdAt])
  @@map("feedback_responses")
}

// ------------------------------------------------------------------------------
// Customer & Staff Feedback Reports / Flags
// ------------------------------------------------------------------------------

model FeedbackReport {
  id            String               @id @default(uuid())
  feedbackId    String
  reportedBy    String?
  reporterEmail String?
  reason        FeedbackReportReason @default(OTHER)
  description   String?
  status        FeedbackReportStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  actionTaken   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  feedback      Feedback             @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  reviewedBy    AdminUser?           @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([feedbackId])
  @@index([status])
  @@index([reviewedById])
  @@index([createdAt])
  @@map("feedback_reports")
}

// ------------------------------------------------------------------------------
// Feedback Moderation History (Audit Trail)
// ------------------------------------------------------------------------------

model FeedbackModerationHistory {
  id             String                   @id @default(uuid())
  feedbackId     String
  moderatorId    String?
  action         FeedbackModerationAction
  previousStatus FeedbackStatus
  newStatus      FeedbackStatus
  reason         String?
  createdAt      DateTime                 @default(now())

  feedback       Feedback                 @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  moderator      AdminUser?               @relation(fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([feedbackId])
  @@index([moderatorId])
  @@index([createdAt])
  @@map("feedback_moderation_history")
}

// ------------------------------------------------------------------------------
// Feedback Status History (Lifecycle Transition Audit Trail)
// ------------------------------------------------------------------------------

model FeedbackStatusHistory {
  id          String         @id @default(uuid())
  feedbackId  String
  changedById String?
  oldStatus   FeedbackStatus
  newStatus   FeedbackStatus
  reason      String?
  createdAt   DateTime       @default(now())

  feedback    Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  changedBy   AdminUser?     @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([feedbackId])
  @@index([changedById])
  @@index([createdAt])
  @@map("feedback_status_history")
}

// ------------------------------------------------------------------------------
// Security Control Center Enums
// ------------------------------------------------------------------------------

enum SecurityEventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityEventSource {
  CUSTOMER_WEB
  CUSTOMER_MOBILE
  SELLER_WEB
  SELLER_MOBILE
  SUBADMIN_WEB
  SUPERADMIN_WEB
  API
  AUTH_SERVICE
  SYSTEM
}

enum SecurityActorType {
  CUSTOMER
  SELLER
  SUBADMIN
  SUPER_ADMIN
  SYSTEM
  ANONYMOUS
}

enum SecurityAlertStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum IpRuleStatus {
  BLOCKED
  WHITELISTED
}

// ------------------------------------------------------------------------------
// Platform Security Events (Centralized Multi-App Telemetry & Audit Stream)
// ------------------------------------------------------------------------------

model SecurityEvent {
  id         String                @id @default(uuid())
  eventType  String
  severity   SecurityEventSeverity @default(INFO)
  source     SecurityEventSource   @default(SYSTEM)
  actorType  SecurityActorType     @default(SYSTEM)
  actorId    String?
  actorEmail String?
  targetType String?
  targetId   String?
  ipAddress  String?
  userAgent  String?
  deviceId   String?
  sessionId  String?
  requestId  String?
  endpoint   String?
  httpMethod String?
  metadata   Json?
  occurredAt DateTime              @default(now())
  createdAt  DateTime              @default(now())

  alerts     SecurityAlert[]

  @@index([eventType])
  @@index([severity])
  @@index([source])
  @@index([actorType])
  @@index([actorId])
  @@index([ipAddress])
  @@index([occurredAt])
  @@index([requestId])
  @@map("security_events")
}

// ------------------------------------------------------------------------------
// Security Alerts (Flagged Security Detections Requiring Triage)
// ------------------------------------------------------------------------------

model SecurityAlert {
  id              String                @id @default(uuid())
  alertType       String
  severity        SecurityEventSeverity @default(MEDIUM)
  title           String
  description     String
  status          SecurityAlertStatus   @default(OPEN)
  source          SecurityEventSource   @default(SYSTEM)
  eventId         String?
  ipAddress       String?
  assignedToId    String?
  detectedAt      DateTime              @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNotes String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  event           SecurityEvent?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assignedTo      AdminUser?            @relation("AlertAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy      AdminUser?            @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  history         SecurityAlertHistory[]

  @@index([status])
  @@index([severity])
  @@index([detectedAt])
  @@index([assignedToId])
  @@index([resolvedById])
  @@index([ipAddress])
  @@map("security_alerts")
}

// ------------------------------------------------------------------------------
// Security Alert History (State Transition Audit Trail)
// ------------------------------------------------------------------------------

model SecurityAlertHistory {
  id          String              @id @default(uuid())
  alertId     String
  changedById String?
  oldStatus   SecurityAlertStatus
  newStatus   SecurityAlertStatus
  action      String
  notes       String?
  createdAt   DateTime            @default(now())

  alert       SecurityAlert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  changedBy   AdminUser?          @relation("AlertChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([alertId])
  @@index([changedById])
  @@index([createdAt])
  @@map("security_alert_history")
}

// ------------------------------------------------------------------------------
// IP Firewall & Blocking Rules
// ------------------------------------------------------------------------------

model IpBlockRule {
  id          String       @id @default(uuid())
  ipAddress   String       @unique
  reason      String
  status      IpRuleStatus @default(BLOCKED)
  blockedBy   String
  createdById String?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy   AdminUser?   @relation("IpRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ipAddress])
  @@index([status])
  @@index([createdAt])
  @@map("ip_block_rules")
}

// ------------------------------------------------------------------------------
// Configurable Security Detection Rules
// ------------------------------------------------------------------------------

model SecurityDetectionRule {
  id                String                @id @default(uuid())
  name              String                @unique
  description       String?
  eventType         String
  threshold         Int                   @default(5)
  timeWindowSeconds Int                   @default(600)
  severity          SecurityEventSeverity @default(HIGH)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([eventType])
  @@index([isActive])
  @@map("security_detection_rules")
}

// ------------------------------------------------------------------------------
// Operational Cities Management
// ------------------------------------------------------------------------------

model OperationalCity {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  timezone    String   @default("Africa/Addis_Ababa")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  maintenanceRecords MaintenanceRecord[]
  systemHealthChecks SystemHealthCheck[]
  systemIncidents    SystemIncident[]
  equipmentLogs      FleetEquipmentLog[]

  @@index([code])
  @@index([isActive])
  @@map("operational_cities")
}

// ------------------------------------------------------------------------------
// System Health Monitoring & Core Services
// ------------------------------------------------------------------------------

model SystemComponent {
  id               String              @id @default(uuid())
  name             String              @unique
  code             String              @unique
  category         ComponentCategory   @default(CORE_API)
  description      String?
  serverNode       String              @default("node-eth-east-1")
  status           ServiceHealthStatus @default(HEALTHY)
  latencyMs        Int                 @default(12)
  uptimePercentage Decimal             @default(99.98) @db.Decimal(5, 2)
  lastCheckedAt    DateTime            @default(now())
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  healthChecks     SystemHealthCheck[]
  incidents        SystemIncident[]

  @@index([code])
  @@index([category])
  @@index([status])
  @@index([isActive])
  @@map("system_components")
}

model SystemHealthCheck {
  id          String              @id @default(uuid())
  componentId String
  component   SystemComponent     @relation(fields: [componentId], references: [id], onDelete: Cascade)
  cityId      String?
  city        OperationalCity?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  status      ServiceHealthStatus @default(HEALTHY)
  latencyMs   Int                 @default(0)
  httpStatus  Int?
  message     String?
  metadata    Json?
  checkedAt   DateTime            @default(now())
  createdAt   DateTime            @default(now())

  @@index([componentId])
  @@index([cityId])
  @@index([status])
  @@index([checkedAt])
  @@map("system_health_checks")
}

// ------------------------------------------------------------------------------
// Maintenance Windows, Tasks & History
// ------------------------------------------------------------------------------

model MaintenanceRecord {
  id               String              @id @default(uuid())
  title            String
  description      String?
  maintenanceType  MaintenanceType     @default(SCHEDULED)
  status           MaintenanceStatus   @default(SCHEDULED)
  priority         MaintenancePriority @default(NORMAL)
  scope            MaintenanceScope    @default(SERVICE)
  affectedServices String[]            @default([])
  announcedToUsers Boolean             @default(true)
  cityId           String?
  city             OperationalCity?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  scheduledStart   DateTime
  scheduledEnd     DateTime?
  actualStart      DateTime?
  actualEnd        DateTime?
  createdById      String?
  createdByAdmin   AdminUser?          @relation("MaintenanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName    String?
  completedById    String?
  completedByAdmin AdminUser?          @relation("MaintenanceCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  statusHistory    MaintenanceStatusHistory[]

  @@index([status])
  @@index([maintenanceType])
  @@index([priority])
  @@index([cityId])
  @@index([scheduledStart])
  @@index([scheduledEnd])
  @@map("maintenance_records")
}

model MaintenanceStatusHistory {
  id             String            @id @default(uuid())
  maintenanceId  String
  maintenance    MaintenanceRecord @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  previousStatus MaintenanceStatus
  newStatus      MaintenanceStatus
  changedById    String?
  changedByAdmin AdminUser?        @relation("MaintenanceStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  reason         String?
  createdAt      DateTime          @default(now())

  @@index([maintenanceId])
  @@index([createdAt])
  @@map("maintenance_status_history")
}

model MaintenanceTask {
  id                  String                  @id @default(uuid())
  name                String
  category            MaintenanceTaskCategory @default(DATABASE)
  description         String?
  frequency           String                  @default("Daily at 03:00 AM")
  status              TaskExecutionStatus     @default(SUCCESS)
  lastRunAt           DateTime?
  lastDurationMs      Int                     @default(0)
  lastTriggeredById   String?
  lastTriggeredByAdmin AdminUser?             @relation("TaskTriggeredBy", fields: [lastTriggeredById], references: [id], onDelete: SetNull)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([category])
  @@index([status])
  @@map("maintenance_tasks")
}

model SystemIncident {
  id              String           @id @default(uuid())
  title           String
  description     String?
  incidentType    String           @default("SERVICE_DEGRADATION")
  severity        IncidentSeverity @default(MEDIUM)
  status          IncidentStatus   @default(OPEN)
  componentId     String?
  component       SystemComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  cityId          String?
  city            OperationalCity? @relation(fields: [cityId], references: [id], onDelete: SetNull)
  detectedAt      DateTime         @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdById     String?
  createdByAdmin  AdminUser?       @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedToId    String?
  assignedToAdmin AdminUser?       @relation("IncidentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedById    String?
  resolvedByAdmin AdminUser?       @relation("IncidentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([severity])
  @@index([cityId])
  @@index([componentId])
  @@index([detectedAt])
  @@map("system_incidents")
}

model FleetEquipmentLog {
  id               String                 @id @default(uuid())
  vehicleId        String
  vehicle          Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleReg       String
  serviceType      String
  cityId           String?
  city             OperationalCity?       @relation(fields: [cityId], references: [id], onDelete: SetNull)
  cityName         String                 @default("Gondar")
  workshopLocation String
  costEtb          Decimal                @default(0.00) @db.Decimal(12, 2)
  scheduledDate    DateTime
  status           EquipmentServiceStatus @default(SCHEDULED)
  technicianNotes  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([vehicleId])
  @@index([cityId])
  @@index([cityName])
  @@index([status])
  @@index([scheduledDate])
  @@map("fleet_equipment_logs")
}






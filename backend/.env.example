# ==============================================================================
# Ardab Market - Backend Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env to source control.

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Neon PostgreSQL Database Connections
# DATABASE_URL: Pooled connection string (with ?sslmode=require&pgbouncer=true or pool_timeout)
# DIRECT_URL: Direct connection string for Prisma migrations (non-pooled)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/ardab_market?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample.region.neon.tech/ardab_market?sslmode=require"

# JWT Authentication
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters_long"
JWT_EXPIRES_IN="1d"

# Allowed CORS Origin(s) (comma-separated, no trailing slashes)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Brevo Transactional Email Configuration
BREVO_API_KEY="xkeysib-replace_with_your_real_brevo_api_key"
BREVO_SENDER_EMAIL="no-reply@ardabmarket.com"
BREVO_SENDER_NAME="Ardab Market"
BREVO_API_BASE_URL="https://api.brevo.com/v3"

# Admin Frontend Base URL (for password reset links)
ADMIN_FRONTEND_URL="http://localhost:3000"

# Cloudinary Image Storage Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ardab-market/products

